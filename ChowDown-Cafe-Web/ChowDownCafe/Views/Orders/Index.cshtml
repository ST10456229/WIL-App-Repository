@model IEnumerable<ChowDownCafe.Models.Order>

@{
    ViewData["Title"] = "Orders";
    var statuses = new[]
    {
        "Pending",
        "Preparing",
        "Ready",
        "Completed",
        "Cancelled"
    };
}

<div class="container mt-4">

    <h1>Orders</h1>

    <p>View and manage customer orders for ChowDown Cafe.</p>

    <div class="mb-3">
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary me-2">
            Back to Dashboard
        </a>

        <a asp-controller="Orders"
           asp-action="Create"
           class="btn btn-primary">
            + Create Order
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No orders have been recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Order Date</th>
                        <th>Notes</th>
                        <th>Items</th>
                        <th>Update Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.OrderId</td>

                            <td>@order.CustomerName</td>

                            <td>@(order.CustomerEmail ?? "—")</td>

                            <td>@(order.CustomerPhone ?? "—")</td>

                            <td>
                                <strong>@order.OrderStatus</strong>
                            </td>

                            <td>
                                @order.OrderDate.ToString("dd MMM yyyy HH:mm")
                            </td>

                            <td>@(order.Notes ?? "—")</td>

                            <td>
                                @if (order.OrderItems.Any())
                                {
                                    <ul class="mb-0">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <li>
                                                Product ID: @item.ProductId
                                                — Qty: @item.Quantity
                                                — R @item.UnitPrice.ToString("N2")
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span>No items</span>
                                }
                            </td>

                            <td>
                                <form asp-controller="Orders"
                                      asp-action="UpdateStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="orderId"
                                           value="@order.OrderId" />

                                    <select name="orderStatus"
                                            class="form-select mb-2"
                                            required>

                                        @foreach (var status in statuses)
                                        {
                                            if (status == order.OrderStatus)
                                            {
                                                <option value="@status" selected>
                                                    @status
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@status">
                                                    @status
                                                </option>
                                            }
                                        }

                                    </select>

                                    <button type="submit"
                                            class="btn btn-sm btn-primary">
                                        Update Status
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
