@model IEnumerable<ChowDownCafe.Models.Product>

@{
    ViewData["Title"] = "Inventory Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Inventory Management</h1>
            <p class="text-muted">
                Monitor product quantities and identify low-stock items.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @{
        var productList = Model?.ToList()
        ?? new List<ChowDownCafe.Models.Product>();

        var lowStockCount = productList.Count(p =>
        p.QuantityInStock <= p.MinimumStockLevel);
    }

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Products</h6>
                    <h2>@productList.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-warning h-100">
                <div class="card-body">
                    <h6 class="text-muted">Low-Stock Products</h6>
                    <h2 class="text-warning">@lowStockCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-success h-100">
                <div class="card-body">
                    <h6 class="text-muted">Products With Sufficient Stock</h6>
                    <h2 class="text-success">
                        @(productList.Count - lowStockCount)
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Current Stock Levels</h5>
        </div>

        <div class="card-body">
            @if (!productList.Any())
            {
                <div class="alert alert-info mb-0">
                    No products found. Add products through Menu Management first.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Quantity in Stock</th>
                                <th>Minimum Stock Level</th>
                                <th>Stock Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var product in productList)
                            {
                                var isLowStock =
                                product.QuantityInStock <= product.MinimumStockLevel;

                                <tr>
                                    <td>@product.ProductName</td>
                                    <td>@product.Category</td>
                                    <td>
                                        @product.QuantityInStock
                                        @product.Unit
                                    </td>
                                    <td>
                                        @product.MinimumStockLevel
                                        @product.Unit
                                    </td>
                                    <td>
                                        @if (product.QuantityInStock == 0)
                                        {
                                            <span class="badge bg-danger">
                                                Out of Stock
                                            </span>
                                        }
                                        else if (isLowStock)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                In Stock
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Inventory"
                                           asp-action="UpdateStock"
                                           asp-route-id="@product.ProductId"
                                           class="btn btn-primary btn-sm">
                                            Update Stock
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="text-muted small mb-0">
                    A product is marked as low stock when its quantity is
                    equal to or below its minimum stock level.
                </p>
            }
        </div>
    </div>
</div>
