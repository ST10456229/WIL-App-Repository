@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="hero-content">
        <p class="eyebrow">WELCOME TO CHOWDOWN CAFE</p>
        <h1>GOOD FOOD.<br /><span>GREAT MOMENTS.</span></h1>
        <p class="hero-description">
            Delicious meals, satisfying snacks and refreshing drinks.
            Your next favourite bite starts here.
        </p>
        <a href="#cafe-services" class="btn-chow">Explore ChowDown</a>
    </div>

    <div class="hero-logo">
        <img src="~/css/images/chowdown-logo.jpg" alt="ChowDown Cafe logo" />
    </div>
</section>

<section class="welcome-section" id="cafe-services">
    <p class="eyebrow">WHAT WE DO</p>
    <h2>Welcome to <span>ChowDown</span></h2>
    <p>
        ChowDown Cafe brings convenient food and great flavours together.
        Our digital management system helps staff manage menu items,
        customer orders, promotions and stock efficiently.
    </p>
</section>

<section class="services-section">
    <div class="section-heading">
        <p class="eyebrow">OUR MANAGEMENT SYSTEM</p>
        <h2>Everything in <span>One Place</span></h2>
    </div>

    <div class="services-grid">
        <article class="service-card">
            <div class="service-icon">🍔</div>
            <h3>Menu Management</h3>
            <p>Manage food items, categories, prices and availability.</p>
        </article>

        <article class="service-card">
            <div class="service-icon">🧾</div>
            <h3>Order Management</h3>
            <p>View customer orders from the Android application and update their progress.</p>
        </article>

        <article class="service-card">
            <div class="service-icon">📦</div>
            <h3>Inventory Control</h3>
            <p>Monitor stock levels and identify items that need replenishing.</p>
        </article>

        <article class="service-card">
            <div class="service-icon">📊</div>
            <h3>Reports & Promotions</h3>
            <p>Manage special offers and review operational information.</p>
        </article>
    </div>
</section>

<section class="management-note">
    <div>
        <p class="eyebrow">BUILT FOR BETTER MANAGEMENT</p>
        <h2>Simple. Efficient. <span>ChowDown.</span></h2>
        <p>
            A central platform for authorised café staff to manage daily operations.
        </p>
    </div>
</section>