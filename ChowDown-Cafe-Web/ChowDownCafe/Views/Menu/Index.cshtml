```cshtml
@model IEnumerable<ChowDownCafe.Models.Product>

@{
    ViewData["Title"] = "Menu Management";
}

<div class="container mt-4">

    <h1>Menu Management</h1>

    <p>Manage and view products stored in the ChowDown Cafe database.</p>

    <!-- Page Action Buttons -->
    <div class="mb-3">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary me-2">
            Back to Dashboard
        </a>

        <a asp-controller="Menu"
           asp-action="Create"
           class="btn btn-primary">
            + Create New Product
        </a>

    </div>

    <hr />

    <!-- Product Information -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No active products found yet.
            Click "Create New Product" to add your first product.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>Product ID</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Unit</th>
                        <th>Quantity in Stock</th>
                        <th>Minimum Stock</th>
                        <th>Unit Price</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.ProductId</td>
                            <td>@product.ProductName</td>
                            <td>@product.Category</td>
                            <td>@product.Unit</td>
                            <td>@product.QuantityInStock</td>
                            <td>@product.MinimumStockLevel</td>
                            <td>
                                @(product.UnitPrice.HasValue
                                                        ? product.UnitPrice.Value.ToString("C2")
                                                        : "Not set")
                    </td>
                </tr>
                                }
                </tbody>

            </table>

        </div>
    }

</div>
```