@model ChowDownCafe.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <h2 class="mb-2">Add New Product</h2>
            <p class="text-muted">
                Enter the details of a product for ChowDown Cafe.
            </p>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-controller="Menu"
                          asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="ProductName"
                                   class="form-label">
                                Product Name
                            </label>
                            <input asp-for="ProductName"
                                   class="form-control"
                                   placeholder="e.g. Chicken Burger" />
                            <span asp-validation-for="ProductName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category"
                                   class="form-label">
                                Category
                            </label>
                            <input asp-for="Category"
                                   class="form-control"
                                   placeholder="e.g. Fast Food" />
                            <span asp-validation-for="Category"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Unit"
                                   class="form-label">
                                Unit
                            </label>
                            <input asp-for="Unit"
                                   class="form-control"
                                   placeholder="e.g. item, cup, portion" />
                            <span asp-validation-for="Unit"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="QuantityInStock"
                                       class="form-label">
                                    Quantity in Stock
                                </label>
                                <input asp-for="QuantityInStock"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />
                                <span asp-validation-for="QuantityInStock"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MinimumStockLevel"
                                       class="form-label">
                                    Minimum Stock Level
                                </label>
                                <input asp-for="MinimumStockLevel"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />
                                <span asp-validation-for="MinimumStockLevel"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UnitPrice"
                                   class="form-label">
                                Unit Price (R)
                            </label>
                            <input asp-for="UnitPrice"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="e.g. 45.00" />
                            <span asp-validation-for="UnitPrice"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsActive"
                                   class="form-check-input" />
                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Active product (show on menu)
                            </label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-dark">
                                Save Product
                            </button>

                            <a asp-controller="Menu"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
