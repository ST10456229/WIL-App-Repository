@model ChowDownCafe.Models.Promotion

@{
    ViewData["Title"] = "Create Promotion";
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <h1 class="fw-bold">Create Promotion</h1>
        <p class="text-muted">
            Add a special offer or discount for ChowDown Cafe customers.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-controller="Promotions"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Promotion Title
                    </label>
                    <input asp-for="Title"
                           class="form-control"
                           placeholder="e.g. Student Special" />
                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the special offer"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiscountPercentage"
                           class="form-label">
                        Discount Percentage (%)
                    </label>
                    <input asp-for="DiscountPercentage"
                           type="number"
                           min="0"
                           max="100"
                           step="0.01"
                           class="form-control"
                           placeholder="e.g. 10" />
                    <span asp-validation-for="DiscountPercentage"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate"
                               class="form-label">
                            Start Date
                        </label>
                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="StartDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate"
                               class="form-label">
                            End Date
                        </label>
                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="EndDate"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive"
                           class="form-check-input" />
                    <label asp-for="IsActive"
                           class="form-check-label">
                        Promotion is active
                    </label>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-dark">
                        Save Promotion
                    </button>

                    <a asp-controller="Promotions"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
