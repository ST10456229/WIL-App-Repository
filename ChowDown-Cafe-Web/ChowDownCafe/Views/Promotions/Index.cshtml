@model IEnumerable<ChowDownCafe.Models.Promotion>

@{
    ViewData["Title"] = "Promotions";
    var today = DateTime.Today;
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="fw-bold">Promotions Management</h1>
            <p class="text-muted mb-0">
                Manage special offers and discounts at ChowDown Cafe.
            </p>
        </div>

        <a asp-controller="Promotions"
           asp-action="Create"
           class="btn btn-dark">
            + Create Promotion
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Promotions</p>
                    <h2 class="fw-bold">@Model.Count()</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Active Promotions</p>
                    <h2 class="fw-bold text-success">
                        @Model.Count(p => p.IsActive
                                                && p.StartDate.Date <= today
                                                && p.EndDate.Date >= today)
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Scheduled Promotions</p>
                    <h2 class="fw-bold text-primary">
                        @Model.Count(p => p.IsActive
                                                && p.StartDate.Date > today)
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">All Promotions</h5>
        </div>

        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Promotion</th>
                                <th>Discount</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var promotion in Model)
                            {
                                var isCurrent =
                                promotion.IsActive
                                && promotion.StartDate.Date <= today
                                && promotion.EndDate.Date >= today;

                                var isScheduled =
                                promotion.IsActive
                                && promotion.StartDate.Date > today;

                                var isExpired =
                                promotion.EndDate.Date < today;

                                <tr>
                                    <td>
                                        <strong>@promotion.Title</strong>
                                        <div class="small text-muted">
                                            @promotion.Description
                                        </div>
                                    </td>

                                    <td>
                                        <span class="fw-bold">
                                            @promotion.DiscountPercentage.ToString("0.##")%
                                        </span>
                                    </td>

                                    <td>
                                        @promotion.StartDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @promotion.EndDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (!promotion.IsActive)
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                        else if (isExpired)
                                        {
                                            <span class="badge bg-danger">
                                                Expired
                                            </span>
                                        }
                                        else if (isCurrent)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else if (isScheduled)
                                        {
                                            <span class="badge bg-primary">
                                                Scheduled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Not Started
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-controller="Promotions"
                                               asp-action="Edit"
                                               asp-route-id="@promotion.PromotionId"
                                               class="btn btn-sm btn-outline-dark">
                                                Edit
                                            </a>

                                            <form asp-controller="Promotions"
                                                  asp-action="ToggleActive"
                                                  asp-route-id="@promotion.PromotionId"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm @(promotion.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                    @(promotion.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5>No promotions yet</h5>
                    <p class="text-muted">
                        Create your first promotion to get started.
                    </p>

                    <a asp-controller="Promotions"
                       asp-action="Create"
                       class="btn btn-dark">
                        Create Your First Promotion
                    </a>
                </div>
            }
        </div>
    </div>
</div>
