@model ChowDownCafe.Models.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Report";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1>ChowDown Cafe</h1>
            <h4>Sales Report</h4>
            <p class="text-muted">
                Review completed sales and order performance.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Reports"
               asp-action="DownloadSalesPdf"
               asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
               class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf"></i>
                Download PDF
            </a>

            <button type="button"
                    class="btn btn-dark"
                    onclick="window.print()">
                Print Report
            </button>
        </div>
    </div>

    <form asp-controller="Reports" asp-action="Sales"
          method="get" class="card card-body mb-4">
        <div asp-validation-summary="All"
             class="text-danger mb-2"></div>

        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="startDate" class="form-label">
                    Start Date
                </label>
                <input type="date" id="startDate" name="startDate"
                       class="form-control"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="col-md-4">
                <label for="endDate" class="form-label">
                    End Date
                </label>
                <input type="date" id="endDate" name="endDate"
                       class="form-control"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    Generate Report
                </button>
            </div>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Completed Sales Revenue</h6>
                    <h3 class="text-success">
                        @Model.TotalSales.ToString("C2",
                        System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))
                    </h3>
                    <small class="text-muted">Completed orders only</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Orders</h6>
                    <h3>@Model.TotalOrders</h3>
                    <small class="text-muted">
                        All statuses in this date range
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Items Sold</h6>
                    <h3>@Model.TotalItemsSold</h3>
                    <small class="text-muted">
                        From completed orders
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6>Pending Orders</h6>
                    <h3>@Model.PendingOrders</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6>Completed Orders</h6>
                    <h3>@Model.CompletedOrders</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6>Cancelled Orders</h6>
                    <h3>@Model.CancelledOrders</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Daily Sales Summary</h5>
        </div>

        <div class="card-body">
            @if (Model.DailySales.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Completed Orders</th>
                                <th>Sales Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var day in Model.DailySales)
                            {
                                <tr>
                                    <td>@day.Date.ToString("dd MMM yyyy")</td>
                                    <td>@day.OrdersCount</td>
                                    <td>
                                        @day.SalesTotal.ToString("C2",
                                        System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No completed sales were found for these dates.
                </p>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Top 5 Selling Products</h5>
        </div>

        <div class="card-body">
            @if (Model.TopSellingProducts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity Sold</th>
                                <th>Sales Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.TopSellingProducts)
                            {
                                <tr>
                                    <td>@product.ProductName</td>
                                    <td>@product.QuantitySold</td>
                                    <td>
                                        @product.SalesTotal.ToString("C2",
                                        System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No completed product sales were found for these dates.
                </p>
            }
        </div>
    </div>

    <p class="text-muted">
        Reporting period:
        @Model.StartDate.ToString("dd MMM yyyy")
        to
        @Model.EndDate.ToString("dd MMM yyyy")
    </p>

    <p class="text-muted small">
        Generated by ChowDown Cafe Management System.
    </p>
</div>

<style>
    @@media print {
        form,
        button,
        a.btn {
            display: none !important;
        }

        .card {
            box-shadow: none !important;
            break-inside: avoid;
        }

        body {
            background: white !important;
        }
    }
</style>
